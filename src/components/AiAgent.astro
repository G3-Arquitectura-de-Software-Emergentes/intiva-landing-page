---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const capabilities = [
  {
    key: '1',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5m-9-6h.008v.008H12v-.008ZM12 15h.008v.008H12V15Zm0 2.25h.008v.008H12v-.008ZM9.75 15h.008v.008H9.75V15Zm0 2.25h.008v.008H9.75v-.008ZM7.5 15h.008v.008H7.5V15Zm0 2.25h.008v.008H7.5v-.008Zm6.75-4.5h.008v.008h-.008v-.008Zm0 2.25h.008v.008h-.008V15Zm0 2.25h.008v.008h-.008v-.008Zm2.25-4.5h.008v.008H16.5v-.008Zm0 2.25h.008v.008H16.5V15Z" /></svg>`,  },
  {
    key: '2',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M9.568 3H5.25A2.25 2.25 0 0 0 3 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 0 0 5.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 0 0 9.568 3Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M6 6h.008v.008H6V6Z" /></svg>`,  },
  {
    key: '3',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H8.25m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H12m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 0 1-2.555-.337A5.972 5.972 0 0 1 5.41 20.97a5.969 5.969 0 0 1-.474-.065 4.48 4.48 0 0 0 .978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25Z" /></svg>`,
  },
];

const planRows = [
  { key: 'market', amount: 'S/ 900', pct: 72, color: 'bg-primary' },
  { key: 'delivery', amount: 'S/ 180', pct: 45, color: 'bg-warning', hint: true },
  { key: 'transport', amount: 'S/ 250', pct: 58, color: 'bg-primary-light' },
];
---

<section id={t('section.ai')} class="section-padding bg-dark relative overflow-hidden">
  <div class="absolute -top-32 right-0 w-[520px] h-[520px] bg-primary/25 rounded-full mix-blend-screen filter blur-[110px] animate-blob pointer-events-none"></div>
  <div class="absolute bottom-0 -left-32 w-[460px] h-[460px] bg-accent/10 rounded-full mix-blend-screen filter blur-[120px] animate-blob pointer-events-none" style="animation-delay: 2s;"></div>

  <div class="container-main relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-20 items-center">

      <!-- Copy + capabilities -->
      <div class="reveal">
        <span class="badge badge-accent">{t('ai.badge')}</span>
        <h2 class="section-title text-white mt-4">
          {t('ai.title.1')} <span class="gradient-text-accent">{t('ai.title.2')}</span>
        </h2>
        <p class="text-lg md:text-xl text-white/70 font-medium mb-12 max-w-xl">
          {t('ai.subtitle')}
        </p>

        <ul class="flex flex-col gap-8 max-w-xl">
          {capabilities.map((cap, i) => (
            <li class="flex items-start gap-5 reveal" style={`transition-delay: ${i * 100}ms;`}>
              <div class="w-12 h-12 shrink-0 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-center text-accent">
                <Fragment set:html={cap.icon} />
              </div>
              <div>
                <h3 class="text-lg font-bold text-white mb-1.5">{t(`ai.${cap.key}.title` as any)}</h3>
                <p class="text-white/60 leading-relaxed text-[15px]">{t(`ai.${cap.key}.desc` as any)}</p>
              </div>
            </li>
          ))}
        </ul>

        <p class="mt-12 flex items-start gap-3 text-sm text-white/60 max-w-xl">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-5 h-5 text-accent shrink-0"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" /></svg>
          <span>{t('ai.trust')}</span>
        </p>
      </div>

      <!-- Agent mockup -->
      <div class="relative flex justify-center reveal" style="transition-delay: 150ms;">
        <div class="relative w-full max-w-[420px]">
          <div class="bg-white rounded-3xl shadow-2xl shadow-primary/30 p-6 animate-float-slow">
            <!-- Agent header -->
            <div class="flex items-center gap-3 mb-5">
              <div class="w-10 h-10 rounded-full bg-linear-to-br from-primary-light to-primary-dark flex items-center justify-center text-accent text-lg shadow-md">✦</div>
              <div class="flex-1">
                <p class="text-sm font-bold text-dark leading-tight">Intiva IA</p>
                <p class="text-[11px] text-success font-medium flex items-center gap-1">
                  <span class="w-1.5 h-1.5 rounded-full bg-success inline-block"></span>
                  {t('ai.mock.status')}
                </p>
              </div>
            </div>

            <!-- Agent message -->
            <div class="bg-lightbg rounded-2xl rounded-tl-sm px-4 py-3 mb-5">
              <p class="text-sm text-dark/80 leading-relaxed">{t('ai.mock.message')}</p>
            </div>

            <!-- Plan draft -->
            <div class="border border-gray-100 rounded-2xl p-4 mb-5">
              <div class="flex items-center justify-between mb-4">
                <p class="text-xs font-bold text-dark uppercase tracking-wider">{t('ai.mock.planTitle')}</p>
                <span class="text-[10px] font-bold text-primary bg-primary/10 px-2 py-0.5 rounded-full">{t('ai.mock.draft')}</span>
              </div>
              <div class="space-y-4">
                {planRows.map((row) => (
                  <div>
                    <div class="flex justify-between text-sm mb-1.5">
                      <span class="font-semibold text-dark">{t(`ai.mock.${row.key}` as any)}</span>
                      <span class="font-bold text-dark">{row.amount}</span>
                    </div>
                    <div class="h-2 rounded-full bg-gray-100 overflow-hidden">
                      <div class={`h-full rounded-full ${row.color}`} style={`width: ${row.pct}%;`}></div>
                    </div>
                    {row.hint && (
                      <p class="text-[11px] text-warning font-semibold mt-1">{t('ai.mock.deliveryHint')}</p>
                    )}
                  </div>
                ))}
                <div class="flex justify-between items-center pt-3 border-t border-gray-100">
                  <span class="text-sm font-semibold text-dark">{t('ai.mock.saving')}</span>
                  <span class="text-sm font-bold text-success">+ S/ 300</span>
                </div>
              </div>
            </div>

            <!-- Actions -->
            <div class="flex gap-3">
              <span class="flex-1 text-center py-3 rounded-xl border-2 border-primary/20 text-primary text-sm font-bold">{t('ai.mock.edit')}</span>
              <span class="flex-1 text-center py-3 rounded-xl bg-accent text-dark text-sm font-bold shadow-[0_0_20px_rgba(205,235,69,0.35)]">{t('ai.mock.approve')}</span>
            </div>
          </div>

          <!-- Floating: category suggestion -->
          <div class="absolute -left-6 sm:-left-12 -bottom-14 bg-white p-3 pr-4 rounded-2xl shadow-xl border border-gray-100 flex items-center gap-3 animate-float-delayed hidden sm:flex">
            <div class="w-9 h-9 rounded-full bg-accent/25 flex items-center justify-center">🛒</div>
            <div>
              <p class="text-[10px] text-muted font-medium">{t('ai.mock.suggested')}</p>
              <p class="text-xs font-bold text-dark">{t('ai.mock.market')} · 92%</p>
            </div>
          </div>

          <!-- Floating: small expenses insight -->
          <div class="absolute -right-4 sm:-right-10 -top-10 bg-white p-3 pr-4 rounded-2xl shadow-xl border border-gray-100 flex items-center gap-3 animate-float hidden sm:flex">
            <div class="w-9 h-9 rounded-full bg-warning/15 flex items-center justify-center">☕</div>
            <div>
              <p class="text-[10px] text-muted font-medium">{t('ai.mock.antTitle')}</p>
              <p class="text-xs font-bold text-dark">{t('ai.mock.antValue')}</p>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
